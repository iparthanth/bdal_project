# Dataset — 541,909 transactions, ~67 MB. Too large for the repository and
# freely re-downloadable from the UCI Machine Learning Repository, so it is
# reproduced by the steps in README.md rather than committed.
data/

# Local build output. Sources and pom.xml are committed; compiled artefacts
# are not, because they are regenerated by javac/jar on any machine.
build/
target/
*.class
*.jar

# Screenshots captured during execution. Kept locally for the report; the
# report PDF itself is committed, the raw captures are not.
screenshots/

# Pig result directories, regenerated by re-running the scripts.
PigAnalysis/output/

# Report working files. The finished PDF is committed at the repo root.
report/
